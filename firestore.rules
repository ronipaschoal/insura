rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Login-by-CPF lookup: the app reads {email} for a given CPF *before*
    // the user is authenticated with Firebase Auth, so this must be
    // world-readable. It exposes only the email tied to a CPF (never the
    // password, which Firebase Auth verifies separately).
    //
    // Write is only allowed once, right after registration creates the
    // Firebase Auth account, and only for the caller's own email — the
    // mapping is immutable after that (no update/delete). If registration
    // instead runs through a Cloud Function with the Admin SDK, that
    // function bypasses these rules entirely and `allow create` here can be
    // narrowed back to `if false`.
    match /cpfIndex/{cpf} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.email == request.auth.token.email;
      allow update, delete: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
